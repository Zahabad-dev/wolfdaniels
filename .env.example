# Copia este archivo como .env.local para desarrollo y configura los mismos
# nombres como variables de entorno en Vercel (Production / Preview / Development).
# NO subir .env.local ni .env con valores reales al repositorio.

# --- Sitio público ---
# Número de WhatsApp para los botones de contacto (formato internacional sin "+", ej. 521XXXXXXXXXX)
NEXT_PUBLIC_WHATSAPP_NUMBER=

# --- Base de datos (CRM v1, backend-only) ---
# Cadena de conexión a PostgreSQL con un usuario de SOLO LECTURA
# (separado del usuario que usa n8n para escribir). Solo se usa en el
# servidor (API routes / server actions), nunca expuesta al frontend.
DATABASE_URL=

# --- Autenticación CRM (NextAuth) ---
# URL base del sitio (https://wolfdaniels.vercel.app o dominio propio)
NEXTAUTH_URL=
# Secreto para firmar sesiones/cookies (generar con: openssl rand -base64 32)
NEXTAUTH_SECRET=
